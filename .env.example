# Leave blank to keep the platform default API URL.
SCENIO_API_BASE_URL=

# iOS OAuth client ID. Required when you test Google Sign-In on iOS.
SCENIO_GOOGLE_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Web OAuth client ID. Reuse this one in scenio_be/.env as GOOGLE_CLIENT_ID.
SCENIO_GOOGLE_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
